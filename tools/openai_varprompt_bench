def bootstrap_marker_summary(out_path: str | Path) -> dict:
    marker_path = Path(out_path).with_suffix(".tilepo_bootstrap.json")
    if not marker_path.exists():
        return {}
    try:
        marker = json.loads(marker_path.read_text())
    except json.JSONDecodeError:
        return {"bootstrap_marker_status": "unreadable", "bootstrap_marker_path": str(marker_path)}
    if not isinstance(marker, dict):
        return {"bootstrap_marker_status": "invalid", "bootstrap_marker_path": str(marker_path)}
    summary = {
        "bootstrap_marker_status": "loaded",
        "bootstrap_marker_path": str(marker_path),
    }
    for key in _BOOTSTRAP_MARKER_ROW_KEYS:
        if key in marker:
            summary[key] = marker[key]
    serving_hook = marker.get("serving_hook")
    if isinstance(serving_hook, dict):
        for key in _SERVING_HOOK_MARKER_ROW_KEYS:
            if key in serving_hook:
                summary[key] = serving_hook[key]
    return summary


def run(args) -> dict:
    out = Path(args.out)
    log_path = Path(args.log)
    log_path.parent.mkdir(parents=True, exist_ok=True)
    log_path.unlink(missing_ok=True)
    if args.plugin_out:
        Path(args.plugin_out).unlink(missing_ok=True)

    prompts = load_prompts(
        args.prompt,
        args.prompts_file,
        args.warmup_request_count + args.request_count,
    )
    warmup_prompts = prompts[: args.warmup_request_count]
    measured_prompts = prompts[
        args.warmup_request_count : args.warmup_request_count + args.request_count
    ]

    command = [str(part) for part in args.server_command]
    env = apply_runtime_env(os.environ.copy(), args.runtime_dir, args.native_tmp_dir)
    pythonpath = env.get("PYTHONPATH", "")
    env["PYTHONPATH"] = str(ROOT) if not pythonpath else str(ROOT) + os.pathsep + pythonpath
    env.update(parse_env(args.extra_env))

    start = time.monotonic()
    proc = None
    try:
        with log_path.open("w") as log:
            gpu_memory_prelaunch_bytes = gpu_memory_used_bytes()
            raise_if_guard_fails(args, f"{args.run_name}-prelaunch", log_path)
            proc = subprocess.Popen(
                command,
                stdout=log,
                stderr=subprocess.STDOUT,
                env=env,
                start_new_session=True,
            )

            models_url = f"http://{args.connect_host or args.host}:{args.port}/v1/models"
            completions_url = (
                f"http://{args.connect_host or args.host}:{args.port}/v1/completions"
            )
            deadline = time.monotonic() + args.startup_timeout_sec
            while time.monotonic() < deadline:
                raise_if_guard_fails(args, f"{args.run_name}-startup", log_path)
                if proc.poll() is not None:
                    raise RuntimeError(
                        f"server exited before readiness with code {proc.returncode}"
                    )
                try:
                    http_json(models_url, timeout=2.0)
                    break
                except (urllib.error.URLError, TimeoutError):
                    time.sleep(2.0)
            else:
                raise RuntimeError(
                    f"server did not become ready within {args.startup_timeout_sec:.0f}s"
                )

            server_ready_after_sec = max(time.monotonic() - start, 1e-9)
            gpu_memory_ready_bytes = gpu_memory_used_bytes()
            warmup_latencies = []
            warmup_usage = {"prompt_tokens": 0, "completion_tokens": 0}
            for index, prompt in enumerate(warmup_prompts, 1):
                raise_if_guard_fails(args, f"{args.run_name}-warmup-{index}", log_path)
                response, latency = completion_request(
                    args, completions_url, prompt, args.request_timeout_sec
                )
                warmup_latencies.append(latency)
                usage = response.get("usage", {})
                warmup_usage["prompt_tokens"] += int(usage.get("prompt_tokens", 0))
                warmup_usage["completion_tokens"] += int(
                    usage.get("completion_tokens", 0)
                )
            gpu_memory_after_warmup_bytes = gpu_memory_used_bytes()

            usage_total = {"prompt_tokens": 0, "completion_tokens": 0}
            request_latencies = []
            request_start = time.monotonic()
            gpu_sampler = GpuMemorySampler()
            gpu_sampler.start()
            try:
                for index, prompt in enumerate(measured_prompts, 1):
                    raise_if_guard_fails(args, f"{args.run_name}-request-{index}", log_path)
                    response, latency = completion_request(
                        args, completions_url, prompt, args.request_timeout_sec
                    )
                    request_latencies.append(latency)
                    usage = response.get("usage", {})
                    usage_total["prompt_tokens"] += int(usage.get("prompt_tokens", 0))
                    usage_total["completion_tokens"] += int(
                        usage.get("completion_tokens", 0)
                    )
            finally:
                gpu_memory_peak_measured_bytes = gpu_sampler.stop()
            elapsed = max(time.monotonic() - request_start, 1e-9)
            total_tokens = usage_total["prompt_tokens"] + usage_total["completion_tokens"]
            completion_tokens = usage_total["completion_tokens"]
            row = {
                "system": args.system,
                "model": args.model,
                "workload": "varprompt_openai_completions",
                "run_name": args.run_name,
                "status": "success",
                "request_count": args.request_count,
                "warmup_request_count": args.warmup_request_count,
                "output_tokens_per_request": args.output_tokens,
                "prompt_tokens": usage_total["prompt_tokens"],
                "completion_tokens": completion_tokens,
                "tokens": total_tokens,
                "tok_per_sec": total_tokens / elapsed if total_tokens > 0 else 0.0,
                "completion_tok_per_sec": completion_tokens / elapsed
                if completion_tokens > 0
                else 0.0,
                "wall_elapsed_sec": elapsed,
                "p50_latency_ms": percentile_ms(request_latencies, 0.50),
                "p95_latency_ms": percentile_ms(request_latencies, 0.95),
                "p99_latency_ms": percentile_ms(request_latencies, 0.99),
                "request_latencies_sec": request_latencies,
                "warmup_latencies_sec": warmup_latencies,
                "warmup_tokens": warmup_usage["prompt_tokens"]
                + warmup_usage["completion_tokens"],
                "server_ready_after_sec": server_ready_after_sec,
                "gpu_memory_prelaunch_bytes": gpu_memory_prelaunch_bytes,
                "gpu_memory_ready_bytes": gpu_memory_ready_bytes,
                "gpu_memory_after_warmup_bytes": gpu_memory_after_warmup_bytes,
                "gpu_memory_peak_measured_bytes": gpu_memory_peak_measured_bytes,
                "gpu_memory_peak_bytes": gpu_memory_peak_measured_bytes,
                "cpu_memory_peak_bytes": memory_peak_bytes(),
                "command": command,
                "log_path": str(log_path),
                "simulated": False,
                "evidence_level": args.evidence_level,
                "prompts": measured_prompts,
            }
            row.update(plugin_summary(args.plugin_out))
            row.update(bootstrap_marker_summary(out))
            write_jsonl(out, row)
            return row
    except Exception as exc:
        elapsed = max(time.monotonic() - start, 1e-9)
        row = {
            "system": args.system,
            "model": args.model,
            "workload": "varprompt_openai_completions",
            "run_name": args.run_name,
            "status": "failed_with_log",
            "request_count": args.request_count,
            "warmup_request_count": args.warmup_request_count,
            "output_tokens_per_request": args.output_tokens,
            "tokens": 0,
            "tok_per_sec": 0.0,
            "completion_tok_per_sec": 0.0,
            "wall_elapsed_sec": elapsed,
            "p50_latency_ms": 0.0,
            "p95_latency_ms": 0.0,
            "p99_latency_ms": 0.0,
            "gpu_memory_failure_bytes": gpu_memory_used_bytes(),
            "gpu_memory_peak_bytes": 0,
            "failure_reason": str(exc),
            "command": command,
            "log_path": str(log_path),
            "simulated": False,
            "evidence_level": args.evidence_level,
        }
        row.update(bootstrap_marker_summary(out))
        write_jsonl(out, row)
        return row
    finally:
        if proc is not None:
            stop_process_group(proc)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--out", required=True)
    parser.add_argument("--log", required=True)
    parser.add_argument("--system", required=True)
    parser.add_argument("--model", default="DeepSeek-V2-Lite")
    parser.add_argument("--run-name", required=True)
    parser.add_argument("--host", default="127.0.0.1")
    parser.add_argument("--connect-host", default="")
    parser.add_argument("--port", type=int, required=True)
    parser.add_argument("--served-model-name", default="tilemem-active")
    parser.add_argument("--prompt", action="append", default=[])
    parser.add_argument("--prompts-file", default="")
    parser.add_argument("--request-count", type=int, default=4)
    parser.add_argument("--warmup-request-count", type=int, default=2)
    parser.add_argument("--output-tokens", type=int, default=1)
    parser.add_argument("--startup-timeout-sec", type=float, default=900.0)
    parser.add_argument("--request-timeout-sec", type=float, default=180.0)
    parser.add_argument("--runtime-dir", default="")
    parser.add_argument("--native-tmp-dir", default="")
    parser.add_argument("--extra-env", action="append", default=[])
    parser.add_argument("--plugin-out", default="")
    parser.add_argument("--evidence-level", default="real")
    parser.add_argument("--c-mount", default="/mnt/c")
    parser.add_argument("--d-mount", default="/mnt/d")
    parser.add_argument("--min-c-free-gib", type=float, default=0.0)
    parser.add_argument("--max-c-use-percent", type=float, default=100.0)
    parser.add_argument("--min-d-free-gib", type=float, default=0.0)
    parser.add_argument("--disk-guard-out", default="")
    parser.add_argument("--max-host-commit-percent", type=float, default=100.0)
    parser.add_argument("--max-vmmem-gib", type=float, default=0.0)
    parser.add_argument("--host-guard-out", default="")
    parser.add_argument("--server-command", nargs=argparse.REMAINDER, required=True)
    args = parser.parse_args()

    row = run(args)
    print(f"wrote {args.system} varprompt metrics to {args.out}: {row['status']}")
    return 0 if row.get("status") == "success" else 1


if __name__ == "__main__":
    raise SystemExit(main())
