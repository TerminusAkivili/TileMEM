def write_jsonl(path: Path, row: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(row) + "\n")


def percentile_ms(samples_sec: list[float], percentile: float) -> float:
    if not samples_sec:
        return 0.0
    values = sorted(samples_sec)
    if len(values) == 1:
        return values[0] * 1000.0
    rank = (len(values) - 1) * percentile
    lower = int(rank)
    upper = min(lower + 1, len(values) - 1)
    fraction = rank - lower
    return (values[lower] + (values[upper] - values[lower]) * fraction) * 1000.0


def memory_peak_bytes() -> int:
    return int(resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss) * 1024


def gpu_memory_used_bytes() -> int:
    try:
        output = subprocess.check_output(
            [
                "nvidia-smi",
                "--query-gpu=memory.used",
                "--format=csv,noheader,nounits",
            ],
            text=True,
            stderr=subprocess.DEVNULL,
        )
    except Exception:
        return 0
    total_mib = 0
    for raw in output.splitlines():
        value = raw.strip().split(",", 1)[0].strip()
        if not value:
            continue
        try:
            total_mib += int(float(value))
        except ValueError:
            continue
    return total_mib * 1024 * 1024


class GpuMemorySampler:
    def __init__(self, poll_interval_sec: float = 0.2, sample_func=gpu_memory_used_bytes):
        self.poll_interval_sec = poll_interval_sec
        self.sample_func = sample_func
        self.peak_bytes = 0
        self._lock = threading.Lock()
        self._stop = threading.Event()
        self._thread: threading.Thread | None = None

    def reset(self) -> None:
        with self._lock:
            self.peak_bytes = 0

    def _sample_once(self) -> int:
        value = max(int(self.sample_func() or 0), 0)
        with self._lock:
            if value > self.peak_bytes:
                self.peak_bytes = value
            return self.peak_bytes

    def _run(self) -> None:
        while not self._stop.wait(self.poll_interval_sec):
            self._sample_once()

    def start(self) -> None:
        if self._thread is not None and self._thread.is_alive():
            return
        self._stop.clear()
        self._sample_once()
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()

    def stop(self) -> int:
        self._stop.set()
        if self._thread is not None:
            self._thread.join(timeout=max(self.poll_interval_sec * 2, 1.0))
        return self._sample_once()


def http_json(url: str, payload: dict | None = None, timeout: float = 10.0) -> dict:
    data = None
    headers = {}
    if payload is not None:
        data = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, headers=headers)
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    with opener.open(request, timeout=timeout) as response:
        return json.loads(response.read().decode("utf-8"))


def stop_process_group(proc: subprocess.Popen, timeout: float = 20.0) -> None:
    pgid = proc.pid

    def group_members() -> list[int]:
        members = []
        for stat_path in Path("/proc").glob("[0-9]*/stat"):
            try:
                text = stat_path.read_text()
                fields = text[text.rfind(")") + 2 :].split()
                if len(fields) >= 3 and int(fields[2]) == pgid:
                    members.append(int(stat_path.parent.name))
            except Exception:
                continue
        return members

    def signal_group(sig: int) -> None:
        try:
            os.killpg(pgid, sig)
        except ProcessLookupError:
            pass
        for pid in group_members():
            try:
                os.kill(pid, sig)
            except ProcessLookupError:
                pass

    signal_group(signal.SIGTERM)
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline and group_members():
        time.sleep(0.1)
    if group_members():
        signal_group(signal.SIGKILL)
    try:
        proc.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        pass


def parse_env(values: list[str]) -> dict[str, str]:
    env = {}
    for value in values:
        if "=" not in value:
            raise ValueError(f"--extra-env expects KEY=VALUE, got {value!r}")
        key, val = value.split("=", 1)
        env[key] = val
    return env


def guard_failure(args, phase: str, kind: str) -> str:
    if kind == "disk":
        if (
            args.min_c_free_gib <= 0
            and args.min_d_free_gib <= 0
            and args.max_c_use_percent >= 100
        ):
            return ""
        try:
            mounts = read_or_collect_mounts(
                df_fixture=None,
                c_mount=args.c_mount,
                d_mount=args.d_mount,
            )
            snapshot = disk_snapshot(
                mounts,
                c_mount=args.c_mount,
                d_mount=args.d_mount,
                min_c_free_gib=args.min_c_free_gib,
                max_c_use_percent=args.max_c_use_percent,
                min_d_free_gib=args.min_d_free_gib,
                phase=phase,
            )
        except Exception as exc:
            snapshot = {
                "phase": phase,
                "status": "fail",
                "failure_reasons": [f"disk guard failed to inspect drives: {exc}"],
                "mounts": {},
            }
        if args.disk_guard_out:
            write_disk_snapshot(Path(args.disk_guard_out), snapshot)
        if snapshot.get("status") != "pass":
            return "; ".join(snapshot.get("failure_reasons", []))
        return ""

    if args.max_host_commit_percent >= 100 and args.max_vmmem_gib <= 0:
        return ""
    try:
        snapshot = host_snapshot(
            read_or_collect_host_info(None),
            max_host_commit_percent=args.max_host_commit_percent,
            max_vmmem_gib=args.max_vmmem_gib,
            phase=phase,
        )
    except Exception as exc:
        snapshot = {
            "phase": phase,
            "status": "fail",
            "failure_reasons": [f"host guard failed to inspect Windows host: {exc}"],
            "host": {},
        }
    if args.host_guard_out:
        write_json_snapshot(Path(args.host_guard_out), snapshot)
    if snapshot.get("status") != "pass":
        return "; ".join(snapshot.get("failure_reasons", []))
    return ""


def raise_if_guard_fails(args, phase: str, log_path: Path) -> None:
    for kind in ("disk", "host"):
        reason = guard_failure(args, phase, kind)
        if reason:
            with log_path.open("a") as log:
                log.write(f"{kind} guard failed: {reason}\n")
            raise RuntimeError(f"{kind} guard failed: {reason}")


def load_prompts(values: list[str], path: str, required: int) -> list[str]:
    prompts = list(values)
    if path:
        prompts.extend(
            line.strip()
            for line in Path(path).read_text().splitlines()
            if line.strip() and not line.lstrip().startswith("#")
        )
    if len(prompts) < required:
        raise ValueError(f"need at least {required} prompts, got {len(prompts)}")
    return prompts


def completion_request(
    args,
    completions_url: str,
    prompt: str,
    timeout: float,
) -> tuple[dict, float]:
    start = time.monotonic()
    response = http_json(
        completions_url,
        payload={
            "model": args.served_model_name,
            "prompt": prompt,
            "max_tokens": args.output_tokens,
            "temperature": 0,
        },
        timeout=timeout,
    )
    latency = max(time.monotonic() - start, 1e-9)
    if not response.get("choices"):
        raise RuntimeError("completion response did not contain choices")
    return response, latency


def plugin_summary(path: str) -> dict:
    if not path:
        return {}
    plugin_path = Path(path)
    if not plugin_path.exists():
        return {"plugin_present": False}
    data = json.loads(plugin_path.read_text())
    decisions = data.get("decisions", [])
    moe = [item for item in decisions if item.get("event") == "tilemem_v3_moe"]
    decision_count = 0
    hotset_prewarm_bytes = 0
    hotset_applied = False
    scheduler_mode = ""
    for item in moe:
        decision_count += int(item.get("decision_count", 1)) if item.get("summary") else 1
        hotset_prewarm_bytes += int(item.get("hotset_prewarm_bytes", 0))
        hotset_applied = hotset_applied or item.get("hotset_applied") is True
        mode = str(item.get("scheduler_mode", ""))
        if mode:
            scheduler_mode = mode if not scheduler_mode else scheduler_mode
    return {
        "plugin_present": True,
        "tilemem_decisions": len(decisions),
        "tilemem_v3_decisions": decision_count,
        "hotset_applied": hotset_applied,
        "scheduler_mode": scheduler_mode,
        "hotset_prewarm_bytes": hotset_prewarm_bytes,
    }


