#!/usr/bin/env python3
from __future__ import annotations

import argparse
from pathlib import Path

from runtime_safety import disk_snapshot, read_or_collect_mounts, write_disk_snapshot


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--out", required=True)
    parser.add_argument("--df-fixture")
    parser.add_argument("--phase", default="disk-guard")
    parser.add_argument("--c-mount", default="/mnt/c")
    parser.add_argument("--d-mount", default="/mnt/d")
    parser.add_argument("--min-c-free-gib", type=float, default=0.0)
    parser.add_argument("--max-c-use-percent", type=float, default=100.0)
    parser.add_argument("--min-d-free-gib", type=float, default=0.0)
    args = parser.parse_args()

    try:
        mounts = read_or_collect_mounts(
            df_fixture=Path(args.df_fixture) if args.df_fixture else None,
            c_mount=args.c_mount,
            d_mount=args.d_mount,
        )
        snapshot = disk_snapshot(
            mounts,
            c_mount=args.c_mount,
            d_mount=args.d_mount,
            min_c_free_gib=args.min_c_free_gib,
            max_c_use_percent=args.max_c_use_percent,
            min_d_free_gib=args.min_d_free_gib,
            phase=args.phase,
        )
    except Exception as exc:
        snapshot = {
            "phase": args.phase,
            "status": "fail",
            "failure_reasons": [f"disk guard failed to inspect drives: {exc}"],
            "mounts": {},
        }
    write_disk_snapshot(Path(args.out), snapshot)
    if snapshot.get("status") != "pass":
        print("; ".join(snapshot.get("failure_reasons", [])))
        return 1
    print("disk guard pass")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
