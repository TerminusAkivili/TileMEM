#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
from pathlib import Path
import shutil
import subprocess
import sys
from typing import Any


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT))


QUICK_VERIFY_COMMANDS = [
    "tools/tests/assert_tilemem_sdk.py",
    "tools/tests/assert_checkpoint_integration.py",
    "tools/tests/assert_release_ready.py",
    "tools/tests/assert_removed_predictor_traces.py",
]

RELEASE_WORKLOADS = ["mixed", "long_context"]
RELEASE_EXPERTS = [2, 4, 6, 8, 10]
RELEASE_POLICIES = ["kt_expert", "tilepo_coarse", "tilepo_fine", "tilepo_hybrid"]
RELEASE_ASYNC_MODES = ["off", "on"]
RELEASE_REPEATS = 3
RELEASE_REQUEST_COUNT = 5
RELEASE_EXPECTED_ROWS = 210
RELEASE_PRECISION = "BF16 / KT-native path"


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="tools/tilemem",
        description="Production-style TileMEM orchestration CLI.",
    )
    subcommands = parser.add_subparsers(dest="command", required=True)

    doctor = subcommands.add_parser("doctor", help="Check local TileMEM runtime readiness.")
    doctor.add_argument("--json", action="store_true", help="Emit machine-readable JSON.")
    doctor.set_defaults(handler=_cmd_doctor)

    verify = subcommands.add_parser("verify", help="Run TileMEM verification gates.")
    verify_mode = verify.add_mutually_exclusive_group()
    verify_mode.add_argument("--quick", action="store_true", help="Run core Python assertions.")
    verify_mode.add_argument("--full", action="store_true", help="Run scripts/verify_artifact.sh.")
    verify.set_defaults(handler=_cmd_verify)

    compile_parser = subcommands.add_parser("compile", help="Compile a model spec or .tmem plan.")
    compile_input = compile_parser.add_mutually_exclusive_group(required=True)
    compile_input.add_argument("--model-spec", type=Path)
    compile_input.add_argument("--plan", type=Path)
    compile_parser.add_argument("--out-dir", type=Path, required=True)
    compile_parser.set_defaults(handler=_cmd_compile)

    checkpoint = subcommands.add_parser("checkpoint", help="Checkpoint integration commands.")
    checkpoint_subcommands = checkpoint.add_subparsers(dest="checkpoint_command", required=True)
    checkpoint_prepare = checkpoint_subcommands.add_parser(
        "prepare",
        help="Prepare a TileMEM artifact from an HF-style MoE checkpoint.",
    )
    checkpoint_prepare.add_argument("--checkpoint-dir", type=Path, required=True)
    checkpoint_prepare.add_argument("--out-dir", type=Path, required=True)
    checkpoint_prepare.add_argument("--name", default="")
    checkpoint_prepare.add_argument("--backend", choices=["sglang", "kt_native"], default="sglang")
    checkpoint_prepare.add_argument("--layers", default="")
    checkpoint_prepare.add_argument("--experts", default="")
    checkpoint_prepare.add_argument("--materialize", action="store_true")
    checkpoint_execution = checkpoint_prepare.add_mutually_exclusive_group()
    checkpoint_execution.add_argument("--dry-run", action="store_true", default=True)
    checkpoint_execution.add_argument("--execute", action="store_true")
    checkpoint_prepare.set_defaults(handler=_cmd_checkpoint_prepare)

    evidence = subcommands.add_parser("evidence", help="Release evidence commands.")
    evidence_subcommands = evidence.add_subparsers(dest="evidence_command", required=True)
    evidence_verify = evidence_subcommands.add_parser(
        "verify",
        help="Verify the checked-in TilePO V0.1 BF16 ablation evidence.",
    )
    evidence_verify.add_argument(
        "--manifest",
        type=Path,
        default=Path("evidence/ablation/tilepo_ablation_manifest.json"),
        help="Ablation manifest to verify.",
    )
    evidence_verify.add_argument(
        "--out-dir",
        type=Path,
        default=Path("build/release_evidence"),
        help="Directory for regenerated summary/report files.",
    )
    evidence_verify.add_argument("--json", action="store_true", help="Emit machine-readable JSON.")
    evidence_verify.set_defaults(handler=_cmd_evidence_verify)

    args = parser.parse_args()
    try:
        return int(args.handler(args))
    except Exception as exc:  # noqa: BLE001 - CLI should return concise operational errors.
        print(f"TileMEM CLI failed: {exc}", file=sys.stderr)
        return 1


def _cmd_doctor(args: argparse.Namespace) -> int:
    payload: dict[str, Any] = {
        "schema_version": "tilemem_cli_doctor_v1",
        "repo_root": str(ROOT),
        "python": sys.version.split()[0],
        "python_executable": sys.executable,
        "tools": {
            "nvcc": shutil.which("nvcc"),
            "nvidia-smi": shutil.which("nvidia-smi"),
            "sglang": shutil.which("sglang"),
        },
    }
    try:
        import tilemem as TM

        payload.update(
            {
                "tilemem_importable": True,
                "tilemem_version": getattr(TM, "__version__", "unknown"),
                "api_symbols": len(getattr(TM, "__all__", [])),
            }
        )
    except Exception as exc:  # noqa: BLE001 - doctor reports import readiness.
        payload.update(
            {
                "tilemem_importable": False,
                "tilemem_version": None,
                "api_symbols": 0,
                "import_error": str(exc),
            }
        )

    if args.json:
        _print_json(payload)
    else:
        print("TileMEM doctor")
        print(f"  repo: {payload['repo_root']}")
        print(f"  python: {payload['python']} ({payload['python_executable']})")
        print(f"  tilemem: {'ok' if payload['tilemem_importable'] else 'failed'}")
        print(f"  api symbols: {payload['api_symbols']}")
        for name, path in payload["tools"].items():
            print(f"  {name}: {path or 'not found'}")
    return 0 if payload["tilemem_importable"] else 1


def _cmd_verify(args: argparse.Namespace) -> int:
    mode = "full" if args.full else "quick"
    if mode == "full":
        commands = [["bash", "scripts/verify_artifact.sh"]]
    else:
        commands = [[sys.executable, command] for command in QUICK_VERIFY_COMMANDS]

    completed = []
    for command in commands:
        result = _run(command)
        completed.append(_relative_command(command))
        if result.returncode != 0:
            _print_failure("verification command failed", command, result)
            _print_json(
                {
                    "schema_version": "tilemem_cli_verify_v1",
                    "mode": mode,
                    "status": "failed",
                    "commands": completed,
                    "returncode": result.returncode,
                }
            )
            return result.returncode

    _print_json(
        {
            "schema_version": "tilemem_cli_verify_v1",
            "mode": mode,
            "status": "passed",
            "commands": [_relative_command(command) for command in commands],
        }
    )
    return 0


def _cmd_compile(args: argparse.Namespace) -> int:
    from tilepo.compiler import compile_model_spec, compile_plan

    if args.model_spec:
        result = compile_model_spec(args.model_spec, args.out_dir)
        input_kind = "model_spec"
        input_path = args.model_spec
    else:
        result = compile_plan(args.plan, args.out_dir)
        input_kind = "plan"
        input_path = args.plan

    _print_json(
        {
            "schema_version": "tilemem_cli_compile_v1",
            "status": "compiled",
            "input_kind": input_kind,
            "input_path": str(input_path),
            "mir_path": str(result.mir_path),
            "manifest_path": str(result.manifest_path),
            "compiled_plan_path": str(result.compiled_plan_path),
        }
    )
    return 0


def _cmd_checkpoint_prepare(args: argparse.Namespace) -> int:
    command = [
        sys.executable,
        str(ROOT / "tools" / "tilemem_checkpoint_prepare"),
        "--checkpoint-dir",
        str(args.checkpoint_dir),
        "--out-dir",
        str(args.out_dir),
        "--backend",
        args.backend,
    ]
    if args.name:
        command.extend(["--name", args.name])
    if args.layers:
        command.extend(["--layers", args.layers])
    if args.experts:
        command.extend(["--experts", args.experts])
    if args.materialize:
        command.append("--materialize")
    command.append("--execute" if args.execute else "--dry-run")

    result = _run(command)
    if result.returncode != 0:
        _print_failure("checkpoint preparation failed", command, result)
        return result.returncode
    print(result.stdout, end="")
    return 0


def _cmd_evidence_verify(args: argparse.Namespace) -> int:
    from tilepo.reporting.ablation import AblationReportError, generate_ablation_report

    try:
        result = generate_ablation_report(
            args.manifest,
            args.out_dir,
            workloads=RELEASE_WORKLOADS,
            experts=RELEASE_EXPERTS,
            policies=RELEASE_POLICIES,
            async_modes=RELEASE_ASYNC_MODES,
            repeats=RELEASE_REPEATS,
            require_real=True,
        )
        manifest = json.loads(Path(args.manifest).read_text())
        runs = [row for row in manifest.get("runs", []) if isinstance(row, dict)]
        real_success_rows = [
            row
            for row in runs
            if row.get("status") == "success"
            and row.get("simulated") is False
            and row.get("evidence_level") == "real"
            and row.get("request_count") == RELEASE_REQUEST_COUNT
            and _is_bf16_only_row(row)
        ]
        actual_rows = int(manifest.get("actual_result_rows", len(runs)))
        expected_rows = int(manifest.get("expected_result_rows", RELEASE_EXPECTED_ROWS))
        failures = []
        if actual_rows != RELEASE_EXPECTED_ROWS or expected_rows != RELEASE_EXPECTED_ROWS:
            failures.append(f"unexpected row count: {actual_rows}/{expected_rows}")
        if len(real_success_rows) != RELEASE_EXPECTED_ROWS:
            failures.append(f"unexpected real success rows: {len(real_success_rows)}/{RELEASE_EXPECTED_ROWS}")
        request_counts = sorted({int(row.get("request_count", -1)) for row in real_success_rows})
        if request_counts != [RELEASE_REQUEST_COUNT]:
            failures.append(f"unexpected request counts: {request_counts}")
        invalid_dtype_rows = [index for index, row in enumerate(runs) if not _is_bf16_only_row(row)]
        if invalid_dtype_rows:
            failures.append(f"non-BF16 rows: {invalid_dtype_rows[:8]}")
        if failures:
            raise AblationReportError("; ".join(failures))
    except (AblationReportError, ValueError, FileNotFoundError, json.JSONDecodeError) as exc:
        payload = _release_evidence_payload(
            status="FAIL",
            gate="FAIL",
            manifest_path=args.manifest,
            summary_path=args.out_dir / "tilepo_ablation_summary.json",
            report_path=args.out_dir / "tilepo_ablation_report.md",
            actual_rows=0,
            expected_rows=RELEASE_EXPECTED_ROWS,
            real_success_rows=0,
            failures=[str(exc)],
        )
        if args.json:
            _print_json(payload)
        else:
            _print_release_evidence(payload)
        return 1

    payload = _release_evidence_payload(
        status="PASS",
        gate=str(result.summary.get("gate", {}).get("status", "PASS")),
        manifest_path=args.manifest,
        summary_path=result.summary_path,
        report_path=result.markdown_path,
        actual_rows=actual_rows,
        expected_rows=expected_rows,
        real_success_rows=len(real_success_rows),
        failures=[],
    )
    if args.json:
        _print_json(payload)
    else:
        _print_release_evidence(payload)
    return 0


def _release_evidence_payload(
    *,
    status: str,
    gate: str,
    manifest_path: Path,
    summary_path: Path,
    report_path: Path,
    actual_rows: int,
    expected_rows: int,
    real_success_rows: int,
    failures: list[str],
) -> dict[str, Any]:
    return {
        "schema_version": "tilemem_release_evidence_v1",
        "status": status,
        "gate": gate,
        "manifest_path": str(manifest_path),
        "summary_path": str(summary_path),
        "report_path": str(report_path),
        "workloads": RELEASE_WORKLOADS,
        "experts": RELEASE_EXPERTS,
        "policies": RELEASE_POLICIES,
        "async_planning": RELEASE_ASYNC_MODES,
        "repeats": RELEASE_REPEATS,
        "request_count": RELEASE_REQUEST_COUNT,
        "actual_rows": actual_rows,
        "expected_rows": expected_rows,
        "real_success_rows": real_success_rows,
        "serving_precision": RELEASE_PRECISION,
        "failures": failures,
    }


def _is_bf16_only_row(row: dict[str, Any]) -> bool:
    dtype_counts = row.get("dtype_counts", {})
    if not isinstance(dtype_counts, dict):
        return False
    if set(dtype_counts) != {"bf16"}:
        return False
    try:
        return int(dtype_counts["bf16"]) > 0
    except (TypeError, ValueError):
        return False


def _print_release_evidence(payload: dict[str, Any]) -> None:
    print("TileMEM / TilePO release evidence")
    print(f"Workloads: {', '.join(payload['workloads'])}")
    print(f"Experts: {', '.join(str(item) for item in payload['experts'])}")
    print(f"Policies: {', '.join(payload['policies'])}")
    print(f"Async planning: {', '.join(payload['async_planning'])}")
    print(f"Repeats: {payload['repeats']}")
    print(f"Request count: {payload['request_count']}")
    print(f"Rows: {payload['real_success_rows']} / {payload['expected_rows']} real success")
    print(f"Gate: {payload['gate']}")
    print(f"Serving precision: {payload['serving_precision']}")
    print(f"Summary: {payload['summary_path']}")
    print(f"Report: {payload['report_path']}")
    for failure in payload["failures"]:
        print(f"Failure: {failure}", file=sys.stderr)


def _run(command: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, cwd=ROOT, capture_output=True, text=True)


def _relative_command(command: list[str]) -> str:
    if len(command) == 2 and command[0] == sys.executable:
        return command[1]
    return " ".join(command)


def _print_failure(message: str, command: list[str], result: subprocess.CompletedProcess[str]) -> None:
    print(f"{message}: {' '.join(command)}", file=sys.stderr)
    if result.stdout:
        print(result.stdout, file=sys.stderr, end="" if result.stdout.endswith("\n") else "\n")
    if result.stderr:
        print(result.stderr, file=sys.stderr, end="" if result.stderr.endswith("\n") else "\n")


def _print_json(payload: dict[str, Any]) -> None:
    print(json.dumps(payload, indent=2, sort_keys=True))


if __name__ == "__main__":
    raise SystemExit(main())
